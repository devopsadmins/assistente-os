{
  "name": "@assistente-os/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "build:web": "npm run build --workspace=@assistente-os/web -- --outDir dist-desktop",
    "prepare:app": "node scripts/copy-web-dist.mjs",
    "package:win": "npm run build:web && npm run prepare:app && electron-packager . assistente-os-desktop --platform=win32 --arch=x64 --out=release --overwrite"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "@electron/packager": "^18.3.6"
  }
}
