{
  "name": "assistente-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "os": "node packages/cli/dist/index.js",
    "graphify:serve": "npx http-server graphify-out -p 8080 -c-1",
    "graphify:open": "npx http-server graphify-out -p 8080 -c-1 -o"
  },
  "devDependencies": {
    "graphviz": "^0.0.9",
    "http-server": "^14.1.1"
  },
  "dependencies": {
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.2.8",
    "@langchain/langgraph": "^1.4.10",
    "@langchain/openai": "^1.5.8",
    "@xenova/transformers": "^2.17.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "say": "^0.16.0",
    "telegraf": "^4.16.3"
  }
}
