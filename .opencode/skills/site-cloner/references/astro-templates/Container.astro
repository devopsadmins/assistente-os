---
interface Props {
  class?: string;
  size?: 'sm' | 'md' | 'lg' | 'xl' | 'full';
  children?: any;
}
const { class: className = '', size = 'lg', children, ...attrs } = Astro.props;

const sizeClasses = {
  sm: 'max-w-3xl',
  md: 'max-w-5xl',
  lg: 'max-w-7xl',
  xl: 'max-w-[80rem]',
  full: 'max-full',
};

const classes = `mx-auto px-4 sm:px-6 lg:px-8 ${sizeClasses[size]} ${className}`;
---

<div class={classes} {...attrs}>
  <slot>{children}</slot>
</div>