# Assistente OS — exemplo de configuração.
# Copie para ~/.assistant-os/.env (a home real; o repo lê via symlink `.env`).
# Só as linhas que você quer sobrescrever precisam existir — tudo tem default.

# ── Núcleo ────────────────────────────────────────────────────────────
ASSISTENTE_OS_HOME=~/.assistant-os
DATABASE_URL=postgres://assistente_os:assistente_os@localhost:5432/assistente_os
# REDIS_URL=redis://localhost:6379          # opcional: cache de RAG compartilhado entre instâncias

# ── Daemon (HTTP + WS) ────────────────────────────────────────────────
AOS_HOST=127.0.0.1
AOS_PORT=4310
# ASSISTENTE_OS_DAEMON_TOKEN=troque-por-um-segredo-forte   # obrigatório se AOS_HOST não for loopback
AOS_RATE_LIMIT=600                          # req/cliente/janela; 0 desliga
AOS_RATE_WINDOW_SEC=60
AOS_MAX_CONCURRENT_EXEC=8                   # execuções caras simultâneas (/chat, missões, pipelines); 0 desliga

# ── Modelos ───────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5-coder:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
# ZEN_API_KEYS=chave1,chave2               # tier `zen`: rodízio round-robin (ou ZEN_API_KEY_1..7 / ZEN_API_KEY)
ZEN_CHAT_MODEL=nemotron-3-ultra-free
# OPENAI_API_KEY=                          # só se usar embeddings/LLM OpenAI

# ── Roteador ──────────────────────────────────────────────────────────
# ASSISTENTE_OS_ROUTER_TIERS=local,zen,soul
ROUTER_ESCALATION=off                       # on = re-tenta 1 degrau após resposta fraca do local
# ROUTER_ESCALATION_MIN_SCORE=0.55
# ROUTER_ESCALATION_MIN_CHARS=40
# ROUTER_ESCALATION_MAX_PER_SESSION=1
# ROUTER_ESCALATION_COOLDOWN_MIN=10
# ROUTER_ESCALATION_FAST_ONLY=1

# ── RAG ───────────────────────────────────────────────────────────────
RAG_RERANK=off                             # off | cross-encoder | llm
RAG_RERANK_CE_MODEL=Xenova/bge-reranker-base
RAG_RERANK_BUDGET_MS=30000
RAG_INJECTION_MODO=aviso                    # aviso | recusar
RAG_HNSW_EF_SEARCH=40
RAG_SEMANTIC_CACHE=off                      # on liga; _THRESHOLD=0.85, _TTL=60

# ── Zero Trust / segurança ────────────────────────────────────────────
MCP_ZERO_TRUST=off                          # on = autonomia × risco no gate de tools (MCP + LangGraph)
PROMPT_INJECTION_MODO=aviso                 # aviso | recusar (entrada do usuário)

# ── LangGraph (opt-in) ────────────────────────────────────────────────
LANGGRAPH_ENABLED=false
# LANGGRAPH_MAX_ITERATIONS=5          # também define o teto global de iterações
                                       # (globalGuardrails.maxIterations, aplicado a
                                       # toda soul), mesmo com LANGGRAPH_ENABLED=false.
                                       # ASSISTENTE_OS_MAX_ITERATIONS é aceita como
                                       # alias (menor precedência — esta vence se as duas existirem).

# ── Skills ────────────────────────────────────────────────────────────
SKILLS_ENABLED=1
# SKILL_MATCH_THRESHOLD=0.35
# SKILL_MAX_ACTIVE=3

# ── Canais / voz (opt-in) ─────────────────────────────────────────────
WHATSAPP_ENABLED=false
TELEGRAM_ENABLED=false
# TELEGRAM_BOT_TOKEN=
VOICE_ENABLED=false

# ── Guardian (aprovação de golden rules por Telegram) ─────────────────
# GUARDIAN_APPROVAL_CHAT_ID=
# GUARDIAN_APPROVAL_TTL_HOURS=24

# ── Azure DevOps (opcional) ───────────────────────────────────────────
# AZURE_DEVOPS_ORG=
# AZURE_DEVOPS_PAT=

# ── Observabilidade (opcional) ────────────────────────────────────────
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Famílias (LGPD — ADR-PRIV-001) ────────────────────────────────────
# FAMILIAS_RETENCAO_DIAS=1825

# ── Backup ────────────────────────────────────────────────────────────
# ASSISTENTE_OS_BACKUP_DIR=~/.assistant-os-backups
