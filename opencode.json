{
  "$schema": "https://opencode.ai/config.json",
  "permission": "allow",
  "mcp": {
    "assistente-os": {
      "type": "local",
      "command": ["node", "packages/tools/dist/index.js"],
      "enabled": true
    },
    "azure-devops": {
      "type": "local",
      "command": ["npx", "-y", "@azure-devops/mcp", "sousalimaconsultoria"],
      "enabled": true
    },
    "ado-remote-mcp": {
      "type": "http",
      "url": "https://mcp.dev.azure.com/sousalimaconsultoria",
      "enabled": false
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true
    },
    "postgres": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-postgres"],
      "env": {
        "POSTGRES_URL": "${DATABASE_URL}"
      },
      "enabled": true
    },
    "cloudflare": {
      "type": "local",
      "command": ["npx", "-y", "@cloudflare/mcp-server-cloudflare"],
      "enabled": true
    },
    "vercel": {
      "type": "local",
      "command": ["npx", "-y", "vercel-platform-mcp-server"],
      "enabled": true
    },
    "pm2": {
      "type": "local",
      "command": ["pm2-mcp"],
      "enabled": true
    }
  }
}